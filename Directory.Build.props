<Project>

  <PropertyGroup>
    <!--
      **版本号唯一来源**：发版只改这一行，别处一律不要写死版本号。

        · 桌面端：产物名 WirelessCable-<版本>.exe / -portable.zip
        · Android：app/build.gradle.kts 读这里当 versionName，
          **versionCode 由它派生**（major*10^7 + minor*10^5 + patch*10^3 + 999），
          不需要（也不允许）手工递增
        · 脚本：build-desktop.sh / build-android.sh / package-release.sh 都读这里

      格式必须是 a.b.c（major≤213、minor≤99、patch≤99，受 Android versionCode 编码限制）。
    -->
    <Version>2.11.2</Version>

    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- 单文件发布时避免 xml/pdb 污染输出 -->
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
    <!-- CA1416: 本项目为 Windows 专用（WPF/Kestrel 桌面托管），不做跨平台可用性告警 -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

</Project>
