<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        浅色主题画刷。键名与 Dark.xaml 一一对应，运行时整份替换即可切换；
        Base.xaml 里的样式一律用 DynamicResource 引用，所以替换后立即生效。
        取样自 docs/ui/desktop-reference.png。
    -->

    <SolidColorBrush x:Key="HeaderBrush" Color="#202936" />
    <SolidColorBrush x:Key="HeaderSubtleBrush" Color="#B9C0CC" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#F3F3F3" />
    <SolidColorBrush x:Key="CardBrush" Color="#FCFCFC" />
    <SolidColorBrush x:Key="CardHoverBrush" Color="#F5F7FA" />
    <SolidColorBrush x:Key="TileBrush" Color="#E0E7F0" />
    <SolidColorBrush x:Key="TileHoverBrush" Color="#D6E0EE" />
    <SolidColorBrush x:Key="TilePressedBrush" Color="#C9D7EA" />
    <SolidColorBrush x:Key="LineBrush" Color="#E2E2E2" />
    <SolidColorBrush x:Key="TextBrush" Color="#1A1A1A" />
    <SolidColorBrush x:Key="MutedBrush" Color="#6B7280" />
    <SolidColorBrush x:Key="AccentBrush" Color="#3985DD" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#2E6FBF" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#E8F1FC" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#008635" />
    <SolidColorBrush x:Key="SuccessPillBrush" Color="#D0EBDA" />
    <SolidColorBrush x:Key="ProgressBrush" Color="#299D79" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#B42318" />
    <SolidColorBrush x:Key="ErrorPillBrush" Color="#FBE3E1" />
    <SolidColorBrush x:Key="IdlePillBrush" Color="#ECECEC" />
    <SolidColorBrush x:Key="HeaderPillBrush" Color="#1C3F39" />
    <SolidColorBrush x:Key="HeaderPillTextBrush" Color="#6FD3A8" />
    <SolidColorBrush x:Key="WipChipBrush" Color="#FFF4D6" />
    <SolidColorBrush x:Key="WipTextBrush" Color="#8A6D1F" />
    <SolidColorBrush x:Key="InputBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="OverlayBrush" Color="#8C101820" />
    <SolidColorBrush x:Key="TrackBrush" Color="#ECECEC" />
    <SolidColorBrush x:Key="MenuBrush" Color="#FCFCFC" />
    <SolidColorBrush x:Key="MenuHoverBrush" Color="#EFF3F8" />

</ResourceDictionary>
