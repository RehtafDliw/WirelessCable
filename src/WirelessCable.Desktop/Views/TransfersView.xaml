<UserControl x:Class="WirelessCable.Desktop.Views.TransfersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}">
    <UserControl.Resources>
        <!-- 一行一条任务：与文件页同一套紧凑行，操作全在右键菜单里 -->
        <DataTemplate x:Key="TransferRowTemplate">
            <Border Style="{StaticResource DenseRow}"
                    ContextMenuOpening="OnRowContextMenuOpening"
                    MouseLeftButtonDown="OnRowMouseLeftButtonDown">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="在资源管理器中显示"
                                  IsEnabled="{Binding CanReveal}"
                                  Click="OnRevealClick" />
                        <Separator />
                        <MenuItem Header="暂停"
                                  IsEnabled="{Binding CanPause}"
                                  Click="OnPauseClick" />
                        <MenuItem Header="继续"
                                  IsEnabled="{Binding CanResume}"
                                  Click="OnResumeClick" />
                        <MenuItem Header="取消"
                                  IsEnabled="{Binding CanCancel}"
                                  Click="OnCancelClick" />
                        <Separator />
                        <MenuItem Header="删除记录…"
                                  IsEnabled="{Binding CanDeleteRecord}"
                                  Click="OnDeleteRecordsClick" />
                    </ContextMenu>
                </Border.ContextMenu>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="210" />
                        <ColumnDefinition Width="80" />
                    </Grid.ColumnDefinitions>

                    <CheckBox Grid.Column="0"
                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                              VerticalAlignment="Center"
                              Focusable="False" />

                    <TextBlock Grid.Column="1"
                               Text="{Binding FileName}"
                               FontSize="13.5"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding FileName}" />

                    <TextBlock Grid.Column="2"
                               Text="{Binding Subtitle}"
                               Style="{StaticResource MutedText}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />

                    <Grid Grid.Column="3" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Detail}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasError}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- 失败原因占据详情位置：单独一行会把紧凑行撑高 -->
                        <TextBlock Text="{Binding ErrorText}"
                                   Foreground="{DynamicResource ErrorBrush}"
                                   FontSize="12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasError}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <Border Grid.Column="4" Style="{StaticResource Pill}" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding StateText}" Style="{StaticResource PillText}" />
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <Style x:Key="TabButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        </Style>
    </UserControl.Resources>

    <StackPanel>

        <!-- 工具栏：页签在左，动作在右 -->
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="{Binding ActiveTabLabel}"
                        Command="{Binding SelectTabCommand}"
                        CommandParameter="active">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource TabButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsActiveTab}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Content="{Binding CompletedTabLabel}"
                        Margin="4,0,0,0"
                        Command="{Binding SelectTabCommand}"
                        CommandParameter="completed">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource TabButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCompletedTab}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>

            <TextBlock Grid.Column="1"
                       Text="{Binding DeviceHint}"
                       Style="{StaticResource MutedText}"
                       VerticalAlignment="Center"
                       Margin="12,0,0,0" />

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Style="{StaticResource PrimaryButton}"
                        Content="发送文件"
                        Command="{Binding SendFilesCommand}" />
                <Button Style="{StaticResource PrimaryButton}"
                        Content="发送文件夹"
                        Margin="8,0,0,0"
                        Command="{Binding SendFolderCommand}" />
                <Button Style="{StaticResource GhostButton}"
                        Content="打开接收目录"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        Command="{Binding OpenSharedFolderCommand}" />
            </StackPanel>
        </Grid>

        <!-- 方向筛选：与"传输中/已完成"正交，一条记录不是发的就是收的 -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="全部"
                    Command="{Binding SelectFilterCommand}"
                    CommandParameter="all">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource TabButton}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsFilterAll}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="我发送的"
                    Margin="4,0,0,0"
                    Command="{Binding SelectFilterCommand}"
                    CommandParameter="sent">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource TabButton}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsFilterSent}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="我收到的"
                    Margin="4,0,0,0"
                    Command="{Binding SelectFilterCommand}"
                    CommandParameter="received">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource TabButton}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsFilterReceived}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>

        <!-- 操作反馈 -->
        <Border Margin="0,0,0,10" Padding="12,8" CornerRadius="8" Background="{DynamicResource TileBrush}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <!-- 用 Hidden 不用 Collapsed：这条只在操作后出现，
                             一冒出来就把表头往下推，鼠标抬起会落在错的行上 -->
                        <DataTrigger Binding="{Binding HasStatus}" Value="False">
                            <Setter Property="Visibility" Value="Hidden" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource BodyText}" />
        </Border>

        <!-- 多选状态条：有勾选才出现 -->
        <Border Margin="0,0,0,8" Padding="12,6" CornerRadius="8" Background="{DynamicResource TileBrush}">
            <Border.Style>
                <Style TargetType="Border">
                    <!-- 必须占位：点表头"全选"后这条一出现就把下面的表头整体下移，
                         鼠标抬起时指针已经落到"删除记录"上，一次全选等于一次误删 -->
                    <Setter Property="Visibility" Value="Hidden" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasSelection}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding SelectionText}"
                           Style="{StaticResource BodyText}"
                           VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource GhostButton}"
                            Content="取消选择"
                            Padding="10,4"
                            Command="{Binding ClearSelectionCommand}" />
                    <Button Style="{StaticResource DangerRowAction}"
                            Content="删除记录"
                            Padding="12,4"
                            Margin="8,0,0,0"
                            Command="{Binding DeleteRecordsCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 表头 -->
        <Grid Margin="8,2,8,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="26" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="80" />
            </Grid.ColumnDefinitions>
            <!-- 26px 宽的列放不下两个字，表头只放一个全选复选框 -->
            <CheckBox Grid.Column="0"
                      IsChecked="{Binding IsAllSelected, Mode=TwoWay}"
                      IsThreeState="False"
                      VerticalAlignment="Center"
                      Focusable="False"
                      ToolTip="全选（当前页签）" />
            <TextBlock Grid.Column="1" Text="名称" Style="{StaticResource ListHeaderText}" />
            <TextBlock Grid.Column="2" Text="方向" Style="{StaticResource ListHeaderText}" />
            <TextBlock Grid.Column="3" Text="进度" Style="{StaticResource ListHeaderText}" />
            <TextBlock Grid.Column="4" Text="状态" Style="{StaticResource ListHeaderText}" />
        </Grid>

        <Border Style="{StaticResource Card}" Padding="10">
            <ItemsControl ItemsSource="{Binding VisibleTasks}"
                          ItemTemplate="{StaticResource TransferRowTemplate}" />
        </Border>

        <!-- 空态 -->
        <Border Padding="18" Margin="0,8,0,0">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource Card}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasVisibleTasks}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <TextBlock Text="{Binding EmptyHint}" Style="{StaticResource BodyText}" />
                <TextBlock Text="手机发来的文件会存到接收目录；电脑发送的文件需在手机上保存后才会落盘"
                           Style="{StaticResource MutedText}"
                           Margin="0,4,0,0" />
            </StackPanel>
        </Border>

    </StackPanel>
</UserControl>
