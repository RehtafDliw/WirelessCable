<Window x:Class="WirelessCable.Desktop.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WirelessCable"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        FontFamily="{DynamicResource UiFont}"
        UseLayoutRounding="True">

    <!--
        自绘确认框：系统 MessageBox 是 Win32 灰底 + 黄三角，与产品主题不一致，
        在深色下尤其突兀。这里用遮罩 + 圆角卡片，颜色跟随当前主题。
    -->
    <Grid x:Name="RootGrid" Background="{DynamicResource OverlayBrush}">
        <Border Background="{DynamicResource CardBrush}"
                CornerRadius="12"
                Width="440"
                MaxHeight="520"
                Padding="26,22,26,18"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.26" Color="#000000" />
            </Border.Effect>

            <StackPanel>
                <TextBlock x:Name="TitleText"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}"
                           TextWrapping="Wrap" />

                <ScrollViewer Margin="0,10,0,0"
                              MaxHeight="320"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <TextBlock x:Name="MessageText"
                               FontSize="13"
                               LineHeight="21"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource MutedBrush}" />
                </ScrollViewer>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,22,0,0">
                    <Button x:Name="CancelButton"
                            Style="{StaticResource GhostButton}"
                            Content="取消"
                            Padding="14,6"
                            Margin="0,0,8,0"
                            IsCancel="True"
                            Click="OnCancel" />
                    <Button x:Name="ConfirmButton"
                            Style="{StaticResource PrimaryButton}"
                            Content="确定"
                            Padding="18,6"
                            IsDefault="True"
                            Click="OnConfirm" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
