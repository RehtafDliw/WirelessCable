<UserControl x:Class="WirelessCable.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}">
    <StackPanel>

        <!-- 网络 -->
        <TextBlock Text="网络" Style="{StaticResource SectionTitle}" Margin="0,0,0,10" />

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="状态" Style="{StaticResource MutedText}" />
                    <TextBlock Grid.Column="1" Text="{Binding Shell.ServiceStatusText}" Style="{StaticResource BodyText}" />
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="监听地址" Style="{StaticResource MutedText}" />
                    <TextBlock Grid.Column="1" Text="{Binding Shell.EndpointText}" Style="{StaticResource BodyText}" />
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="运行时长" Style="{StaticResource MutedText}" />
                    <TextBlock Grid.Column="1" Text="{Binding Shell.UptimeText}" Style="{StaticResource BodyText}" />
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="数据库" Style="{StaticResource MutedText}" />
                    <TextBlock Grid.Column="1" Text="{Binding Shell.DatabaseReadyText}" Style="{StaticResource BodyText}" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- 共享目录 -->
        <TextBlock Text="共享目录" Style="{StaticResource SectionTitle}" Margin="0,20,0,10" />

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="接收目录" Style="{StaticResource MutedText}" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding Shell.SharedDirectory}"
                               Style="{StaticResource BodyText}"
                               TextTrimming="CharacterEllipsis" />
                    <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="打开"
                            Command="{Binding Shell.OpenFolderCommand}"
                            CommandParameter="{Binding Shell.SharedDirectory}" />
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="数据" Style="{StaticResource MutedText}" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding DataDirectoryText}"
                               Style="{StaticResource BodyText}"
                               TextTrimming="CharacterEllipsis" />
                    <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="更改"
                            Command="{Binding ChangeDataDirectoryCommand}" />
                    <Button Grid.Column="3" Style="{StaticResource GhostButton}" Content="打开"
                            Margin="6,0,0,0"
                            Command="{Binding Shell.OpenFolderCommand}"
                            CommandParameter="{Binding DataDirectoryText}" />
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="日志" Style="{StaticResource MutedText}" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding LogDirectoryText}"
                               Style="{StaticResource BodyText}"
                               TextTrimming="CharacterEllipsis" />
                    <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="更改"
                            Command="{Binding ChangeLogDirectoryCommand}" />
                    <Button Grid.Column="3" Style="{StaticResource GhostButton}" Content="打开"
                            Margin="6,0,0,0"
                            Command="{Binding Shell.OpenFolderCommand}"
                            CommandParameter="{Binding LogDirectoryText}" />
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RestartRequired}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="重启后生效"
                               Style="{StaticResource MutedText}"
                               VerticalAlignment="Center" />
                    <Button Style="{StaticResource PrimaryButton}"
                            Content="重启应用"
                            Margin="12,0,0,0"
                            Command="{Binding RestartCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 设备 -->
        <TextBlock Text="设备" Style="{StaticResource SectionTitle}" Margin="0,20,0,10" />

        <Border Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="已配对" Style="{StaticResource MutedText}" />
                <TextBlock Grid.Column="1" Style="{StaticResource BodyText}">
                    <Run Text="{Binding Shell.DeviceRows.Count, Mode=OneWay}" />
                    <Run Text="台" />
                </TextBlock>
                <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="管理设备"
                        Command="{Binding Shell.NavigateCommand}"
                        CommandParameter="devices" />
            </Grid>
        </Border>

        <!-- 安全 -->
        <TextBlock Text="安全" Style="{StaticResource SectionTitle}" Margin="0,20,0,10" />

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="证书指纹" Style="{StaticResource MutedText}" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding Shell.FingerprintDisplay}"
                               FontFamily="Consolas"
                               FontSize="12"
                               Foreground="{DynamicResource TextBrush}"
                               TextWrapping="Wrap" />
                    <Button Grid.Column="2"
                            Style="{StaticResource GhostButton}"
                            Content="复制"
                            VerticalAlignment="Top"
                            Command="{Binding Shell.CopyFingerprintCommand}" />
                </Grid>
                <TextBlock Text="手机配对时用它核对身份；指纹变了说明证书被换过。"
                           Style="{StaticResource MutedText}"
                           Margin="110,6,0,0" />
            </StackPanel>
        </Border>

        <!-- 外观 -->
        <TextBlock Text="外观" Style="{StaticResource SectionTitle}" Margin="0,20,0,10" />

        <Border Style="{StaticResource Card}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="主题" Style="{StaticResource MutedText}" Width="110" VerticalAlignment="Center" />
                <Button Content="跟随系统" Padding="14,6" Margin="0,0,8,0"
                        Command="{Binding SetThemeCommand}" CommandParameter="system">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsThemeSystem}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="浅色" Padding="14,6" Margin="0,0,8,0"
                        Command="{Binding SetThemeCommand}" CommandParameter="light">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsThemeLight}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="深色" Padding="14,6"
                        Command="{Binding SetThemeCommand}" CommandParameter="dark">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsThemeDark}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border>

        <!-- 启动 -->
        <TextBlock Text="启动" Style="{StaticResource SectionTitle}" Margin="0,20,0,10" />

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="开机自启" Style="{StaticResource BodyText}" />
                        <TextBlock Text="登录 Windows 后自动启动，手机随时能连"
                                   Style="{StaticResource MutedText}"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                    <ToggleButton Grid.Column="1"
                                  Style="{StaticResource ToggleSwitch}"
                                  VerticalAlignment="Center"
                                  IsChecked="{Binding StartWithWindows, Mode=TwoWay}" />
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="关闭窗口时收进托盘" Style="{StaticResource BodyText}" />
                        <TextBlock Text="传输不会中断，从托盘图标恢复窗口"
                                   Style="{StaticResource MutedText}"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                    <ToggleButton Grid.Column="1"
                                  Style="{StaticResource ToggleSwitch}"
                                  VerticalAlignment="Center"
                                  IsChecked="{Binding CloseToTray, Mode=TwoWay}" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- 关于 -->
        <TextBlock Text="关于" Style="{StaticResource SectionTitle}" Margin="0,20,0,10" />

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="设备名" Style="{StaticResource MutedText}" />
                    <TextBlock Grid.Column="1" Text="{Binding Shell.DeviceNameText}" Style="{StaticResource BodyText}" />
                </Grid>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="协议版本" Style="{StaticResource MutedText}" />
                    <TextBlock Grid.Column="1" Text="{Binding Shell.ProtocolVersionText}" Style="{StaticResource BodyText}" />
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="应用版本" Style="{StaticResource MutedText}" />
                    <TextBlock Grid.Column="1" Text="{Binding Shell.AppVersionText}" Style="{StaticResource BodyText}" />
                </Grid>
            </StackPanel>
        </Border>

    </StackPanel>
</UserControl>
