<UserControl x:Class="WirelessCable.Desktop.Views.MyComputerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}">
    <StackPanel>

        <!-- 路径与操作 -->
        <Grid Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource GhostButton}"
                        Content="← 返回上级"
                        Command="{Binding GoUpCommand}" />
                <TextBlock Text="{Binding PathDisplay}"
                           Style="{StaticResource MutedText}"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource GhostButton}" Content="在资源管理器中打开"
                        Command="{Binding OpenInExplorerCommand}" />
                <Button Style="{StaticResource GhostButton}" Content="新建文件夹" Margin="8,0,0,0"
                        Command="{Binding CreateDirectoryCommand}" />
                <Button Style="{StaticResource GhostButton}" Content="刷新" Margin="8,0,0,0"
                        Command="{Binding RefreshCommand}" />
            </StackPanel>
        </Grid>

        <!-- 排序与批量操作 -->
        <Grid Margin="0,0,0,6">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource GhostButton}" Content="{Binding NameSortText}"
                        Command="{Binding SortCommand}" CommandParameter="name" />
                <Button Style="{StaticResource GhostButton}" Content="{Binding SizeSortText}" Margin="8,0,0,0"
                        Command="{Binding SortCommand}" CommandParameter="size" />
                <Button Style="{StaticResource GhostButton}" Content="{Binding TimeSortText}" Margin="8,0,0,0"
                        Command="{Binding SortCommand}" CommandParameter="time" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="{Binding CheckedText}" Style="{StaticResource MutedText}"
                           VerticalAlignment="Center" Margin="0,0,10,0" />
                <Button Style="{StaticResource GhostButton}" Content="全选"
                        Command="{Binding SelectAllCommand}" CommandParameter="all" />
                <Button Style="{StaticResource GhostButton}" Content="取消选择" Margin="8,0,0,0"
                        Command="{Binding SelectAllCommand}" CommandParameter="none" />
                <Button Style="{StaticResource DangerLink}" Content="删除选中" Margin="8,0,0,0"
                        Command="{Binding DeleteSelectedCommand}" />
            </StackPanel>
        </Grid>

        <!-- 条目 -->
        <Border Style="{StaticResource Card}" Padding="10">
            <StackPanel>
                <Grid Margin="8,2,8,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="104" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="名称" Style="{StaticResource ListHeaderText}" />
                    <TextBlock Grid.Column="2" Text="类型" Style="{StaticResource ListHeaderText}" />
                    <TextBlock Grid.Column="3" Text="大小" Style="{StaticResource ListHeaderText}" />
                    <TextBlock Grid.Column="4" Text="修改时间" Style="{StaticResource ListHeaderText}" />
                </Grid>

                <ItemsControl ItemsSource="{Binding VisibleEntries}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- 双击：目录进入、文件用系统程序打开；右键出菜单 -->
                            <Border Style="{StaticResource DenseRow}"
                                    MouseLeftButtonDown="OnRowMouseLeftButtonDown">
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="打开" Click="OnMenuOpenClick" />
                                        <MenuItem Header="在资源管理器中显示" Click="OnMenuRevealClick" />
                                        <Separator />
                                        <MenuItem Header="重命名…" Click="OnMenuRenameClick" />
                                        <MenuItem Header="删除" Click="OnMenuDeleteClick" />
                                        <Separator />
                                        <MenuItem Header="属性" Click="OnMenuPropertiesClick" />
                                    </ContextMenu>
                                </Border.ContextMenu>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="104" />
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0" MinWidth="0"
                                              VerticalAlignment="Center"
                                              IsChecked="{Binding IsChecked, Mode=TwoWay}" />

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock FontFamily="{StaticResource IconFont}"
                                                   FontSize="13"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   Margin="0,0,7,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="&#xE8A5;" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                                            <Setter Property="Text" Value="&#xE8B7;" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Name}" FontSize="13"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="2" Text="{Binding TypeText}"
                                               Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{Binding SizeText}"
                                               Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="4" Text="{Binding ModifiedText}"
                                               Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 空态 -->
                <TextBlock Text="这个文件夹是空的" Margin="8,16,8,16">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Entries.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- 分页 -->
        <Grid Margin="0,10,0,0">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasPages}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource GhostButton}" Content="上一页"
                        Command="{Binding PrevPageCommand}" />
                <TextBlock Text="{Binding PageText}" Style="{StaticResource MutedText}"
                           VerticalAlignment="Center" Margin="10,0" />
                <Button Style="{StaticResource GhostButton}" Content="下一页"
                        Command="{Binding NextPageCommand}" />
            </StackPanel>
        </Grid>

        <TextBlock Text="{Binding StatusText}"
                   Foreground="{DynamicResource ErrorBrush}"
                   FontSize="12.5"
                   Margin="0,10,0,0">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasStatus}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

    </StackPanel>
</UserControl>
