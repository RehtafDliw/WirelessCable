<Window x:Class="WirelessCable.Desktop.Views.GrantPermissionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="目录授权"
        Width="520"
        Height="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        FontFamily="{StaticResource UiFont}"
        Background="{DynamicResource SurfaceBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold" />
            <TextBlock x:Name="PathText" Style="{StaticResource MutedText}" Margin="0,3,0,0"
                       TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="Rows">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding DeviceName}" FontSize="14" />
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}"
                                               Margin="0,2,0,0" />
                                </StackPanel>

                                <ComboBox Grid.Column="1"
                                          Width="150"
                                          VerticalAlignment="Center"
                                          ItemsSource="{Binding Options}"
                                          DisplayMemberPath="Label"
                                          SelectedValuePath="Value"
                                          SelectedValue="{Binding SelectedValue, Mode=TwoWay}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Style="{StaticResource GhostButton}" Content="取消" Click="OnCancel" />
            <Button Style="{StaticResource PrimaryButton}" Content="保存" Click="OnSave" Margin="8,0,0,0" />
        </StackPanel>
    </Grid>
</Window>
