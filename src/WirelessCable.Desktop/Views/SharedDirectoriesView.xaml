<UserControl x:Class="WirelessCable.Desktop.Views.SharedDirectoriesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}">
    <StackPanel>

        <Grid Margin="0,0,0,10">
            <TextBlock Text="整机浏览" Style="{StaticResource SectionTitle}" />
        </Grid>

        <TextBlock Style="{StaticResource MutedText}"
                   Text="允许手机像资源管理器一样访问这台电脑的全部文件。默认可读写（含删除），可按设备改为只读或关闭。"
                   Margin="0,0,0,10" />

        <Border Style="{StaticResource Card}" Padding="12">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Shell.SharedDirectories.MachineAccessRows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource LineBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="0,10,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="{Binding DisplayName}"
                                               FontSize="14.5"
                                               VerticalAlignment="Center" />

                                    <ComboBox Grid.Column="1"
                                              Width="92"
                                              VerticalAlignment="Center"
                                              ItemsSource="{Binding Options}"
                                              DisplayMemberPath="Text"
                                              SelectedValuePath="Level"
                                              SelectedValue="{Binding Level, Mode=TwoWay}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="暂无已配对设备"
                           Margin="0,14,0,0"
                           Visibility="Collapsed">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Shell.SharedDirectories.MachineAccessRows.Count}"
                                             Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>

        <Grid Margin="0,24,0,10">
            <TextBlock Text="共享目录" Style="{StaticResource SectionTitle}" />
            <Button Style="{StaticResource PrimaryButton}"
                    Content="添加目录"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Command="{Binding Shell.SharedDirectories.AddDirectoryCommand}" />
        </Grid>

        <TextBlock Style="{StaticResource MutedText}"
                   Text="每台手机单独授权：只读、读写（不能删）、读写并允许删除。"
                   Margin="0,0,0,10" />

        <Border Style="{StaticResource Card}" Padding="12">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Shell.SharedDirectories.Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource LineBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="0,10,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontSize="14.5"
                                                       FontWeight="SemiBold" />
                                            <Border Style="{StaticResource Pill}"
                                                    Margin="8,0,0,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding PermissionsText}"
                                                           Style="{StaticResource PillText}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding RootPath}"
                                                   Style="{StaticResource MutedText}"
                                                   Margin="0,3,0,0"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding GrantsText}"
                                                   Style="{StaticResource MutedText}"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>

                                    <Button Grid.Column="1"
                                            Style="{StaticResource GhostButton}"
                                            Content="授权"
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Center"
                                            Command="{Binding DataContext.Shell.SharedDirectories.EditGrantsCommand,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding DirectoryId}" />

                                    <Button Grid.Column="2"
                                            Style="{StaticResource GhostButton}"
                                            Content="移除"
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            Command="{Binding DataContext.Shell.SharedDirectories.RemoveDirectoryCommand,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding DirectoryId}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="暂无共享目录"
                           Margin="0,14,0,0"
                           Visibility="Collapsed">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Shell.SharedDirectories.Rows.Count}"
                                             Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource MutedText}"
                   Margin="0,10,0,0"
                   Text="未授权的目录，手机看不到也访问不了。" />

    </StackPanel>
</UserControl>
