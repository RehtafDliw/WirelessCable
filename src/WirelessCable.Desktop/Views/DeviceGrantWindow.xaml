<Window x:Class="WirelessCable.Desktop.Views.DeviceGrantWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="授权"
        Width="460"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource SurfaceBrush}"
        FontFamily="{StaticResource UiFont}">
    <StackPanel Margin="20">

        <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" />

        <!-- 模式：整机 / 目录（用户明确要求先选模式，再选目录） -->
        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
            <RadioButton x:Name="MachineMode" Content="整机授权" IsChecked="True" GroupName="mode"
                         Checked="OnModeChanged" />
            <RadioButton x:Name="FolderMode" Content="目录授权" Margin="18,0,0,0" GroupName="mode"
                         Checked="OnModeChanged" />
        </StackPanel>

        <!-- 整机：只要选档位 -->
        <StackPanel x:Name="MachinePanel" Margin="0,14,0,0">
            <TextBlock Text="这台手机能对电脑做什么" FontSize="12.5"
                       Foreground="{DynamicResource MutedBrush}" />
            <ComboBox x:Name="MachineLevel" Width="200" HorizontalAlignment="Left" Margin="0,6,0,0" />
        </StackPanel>

        <!-- 目录：先选目录，再选档位 -->
        <StackPanel x:Name="FolderPanel" Margin="0,14,0,0" Visibility="Collapsed">
            <TextBlock Text="共享目录" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" />
            <ComboBox x:Name="DirectoryBox" Width="320" HorizontalAlignment="Left" Margin="0,6,0,0"
                      DisplayMemberPath="DisplayName" SelectionChanged="OnDirectoryChanged" />
            <TextBlock Text="权限档位" FontSize="12.5" Foreground="{DynamicResource MutedBrush}"
                       Margin="0,12,0,0" />
            <ComboBox x:Name="FolderLevel" Width="200" HorizontalAlignment="Left" Margin="0,6,0,0" />
        </StackPanel>

        <TextBlock x:Name="HintText" FontSize="12" Foreground="{DynamicResource MutedBrush}"
                   TextWrapping="Wrap" Margin="0,12,0,0" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="取消" Width="88" Height="32" Click="OnCancel" />
            <Button Content="确定" Width="88" Height="32" Margin="10,0,0,0" Click="OnSave" />
        </StackPanel>
    </StackPanel>
</Window>
