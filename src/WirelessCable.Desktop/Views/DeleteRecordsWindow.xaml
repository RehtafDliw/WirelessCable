<Window x:Class="WirelessCable.Desktop.Views.DeleteRecordsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WirelessCable"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        FontFamily="{DynamicResource UiFont}"
        UseLayoutRounding="True">

    <!--
        删除传输记录：与 ConfirmDialog 同一套外观，多一个「同时删文件」勾选。
        不直接复用 ConfirmDialog 是因为它只有两个按钮，
        而"只删记录 / 连文件一起删"必须让用户显式选，不能靠按钮文案猜。
    -->
    <Grid x:Name="RootGrid" Background="{DynamicResource OverlayBrush}">
        <Border Background="{DynamicResource CardBrush}"
                CornerRadius="12"
                Width="460"
                MaxHeight="520"
                Padding="26,22,26,18"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.26" Color="#000000" />
            </Border.Effect>

            <StackPanel>
                <TextBlock x:Name="TitleText"
                           Text="删除传输记录"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}"
                           TextWrapping="Wrap" />

                <TextBlock x:Name="MessageText"
                           Margin="0,10,0,0"
                           FontSize="13"
                           LineHeight="21"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource MutedBrush}" />

                <CheckBox x:Name="DeleteFilesCheck"
                          Margin="0,14,0,0"
                          FontSize="13"
                          Content="同时删除接收到的文件" />

                <TextBlock x:Name="FilesHint"
                           Margin="24,4,0,0"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource MutedBrush}" />

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,22,0,0">
                    <Button Style="{StaticResource GhostButton}"
                            Content="取消"
                            Padding="14,6"
                            Margin="0,0,8,0"
                            IsCancel="True"
                            Click="OnCancel" />
                    <Button Style="{StaticResource DangerButton}"
                            Content="删除"
                            Padding="18,6"
                            IsDefault="True"
                            Click="OnConfirm" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
