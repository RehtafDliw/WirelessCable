<UserControl x:Class="WirelessCable.Desktop.Views.DevicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}">
    <StackPanel>

        <!-- 配对新设备 -->
        <TextBlock Text="配对新设备" Style="{StaticResource SectionTitle}" Margin="0,0,0,10" />

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource PrimaryButton}"
                            Content="生成配对二维码"
                            Command="{Binding Shell.ShowPairingQrCommand}" />
                    <TextBlock Text="{Binding Shell.QrStatusText}"
                               Style="{StaticResource MutedText}"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0" />
                </StackPanel>

                <Border Margin="0,14,0,0" HorizontalAlignment="Left">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Shell.QrImage}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Border Background="White" CornerRadius="8" Padding="10"
                            BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                        <Image Source="{Binding Shell.QrImage}" Width="200" Height="200"
                               RenderOptions.BitmapScalingMode="NearestNeighbor" />
                    </Border>
                </Border>

                <!-- 电脑热点：手机与电脑不在同一网络时，手机连它再扫码 -->
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <TextBlock Text="{Binding Shell.HotspotText}"
                               Style="{StaticResource MutedText}"
                               VerticalAlignment="Center" />
                    <Button Content="关闭热点"
                            Margin="10,0,0,0"
                            Command="{Binding Shell.StopHotspotCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Shell.IsHotspotActive}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <TextBlock Text="{Binding Shell.PairingError}"
                           Foreground="{DynamicResource ErrorBrush}"
                           FontSize="12.5"
                           Margin="0,10,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Shell.PairingError}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- 待处理请求 -->
        <TextBlock Text="配对请求" Style="{StaticResource SectionTitle}" Margin="0,20,0,10" />

        <ItemsControl ItemsSource="{Binding Shell.PairingRequests}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding DeviceName}" FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding PlatformText}" Style="{StaticResource MutedText}" Margin="0,2,0,0" />
                                </StackPanel>
                                <Border Grid.Column="1" Style="{StaticResource Pill}">
                                    <TextBlock Text="{Binding StateText}" Style="{StaticResource PillText}" />
                                </Border>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <TextBlock Text="{Binding Code}"
                                           FontSize="26"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextBrush}"
                                           FontFamily="Consolas" />
                                <TextBlock Text="{Binding ExpiresText}"
                                           Style="{StaticResource MutedText}"
                                           VerticalAlignment="Bottom"
                                           Margin="14,0,0,6" />
                                <Button Style="{StaticResource GhostButton}"
                                        Content="复制"
                                        VerticalAlignment="Bottom"
                                        Margin="10,0,0,4"
                                        Command="{Binding DataContext.Shell.CopyTextCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding Code}" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CanDecide}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Button Style="{StaticResource PrimaryButton}"
                                        Content="允许"
                                        Margin="0,0,8,0"
                                        Command="{Binding DataContext.Shell.ApprovePairingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding RequestId}" />
                                <Button Style="{StaticResource GhostButton}"
                                        Content="拒绝"
                                        Command="{Binding DataContext.Shell.RejectPairingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding RequestId}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Padding="18">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource Card}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Shell.HasAnyPairingSession}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="无待处理请求" Style="{StaticResource MutedText}" />
        </Border>

        <!-- 已配对设备 -->
        <TextBlock Text="已配对设备" Style="{StaticResource SectionTitle}" Margin="0,20,0,10" />

        <ItemsControl ItemsSource="{Binding Shell.DeviceRows}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DisplayName}" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}" Margin="0,2,0,0" />
                            </StackPanel>

                            <Border Grid.Column="1" Style="{StaticResource Pill}" Margin="0,0,10,0">
                                <TextBlock Text="{Binding StatusText}" Style="{StaticResource PillText}" />
                            </Border>

                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button Style="{StaticResource GhostButton}"
                                        Content="改名"
                                        Margin="0,0,6,0"
                                        Command="{Binding DataContext.Shell.RenameDeviceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding DeviceId}" />
                                <Button Style="{StaticResource GhostButton}"
                                        Content="撤销"
                                        Margin="0,0,6,0"
                                        Command="{Binding DataContext.Shell.RevokeDeviceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding DeviceId}" />
                                <Button Style="{StaticResource GhostButton}"
                                        Content="删除"
                                        Command="{Binding DataContext.Shell.DeleteDeviceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding DeviceId}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Padding="18">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource Card}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Shell.HasDevices}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <TextBlock Text="无已配对设备" Style="{StaticResource BodyText}" />
                <TextBlock Text="手机配对后会出现在这里" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <TextBlock Text="{Binding Shell.DeviceSummary}" Style="{StaticResource MutedText}" Margin="0,12,0,0" />

    </StackPanel>
</UserControl>
