<UserControl x:Class="WirelessCable.Desktop.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}">
    <StackPanel>

        <!-- 设备连接：多设备选择 + 配对入口（服务状态在标题栏） -->
        <Grid Margin="0,0,0,10">
            <TextBlock Text="设备连接" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
        </Grid>

        <Border Style="{StaticResource Card}" Padding="8">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Shell.DeviceRows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- 一行一台设备：信息在左，操作在右。
                                 侧栏不再有「我的手机」——多设备时它只认"当前设备"，
                                 得先切设备再回来，绕；这里直接点名进入。 -->
                            <Grid Margin="2,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           FontFamily="{StaticResource IconFont}"
                                           Text="&#xE73E;"
                                           FontSize="14"
                                           Foreground="{DynamicResource AccentBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Hidden" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DisplayName}" FontSize="14.5" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Detail}"
                                               Style="{StaticResource MutedText}"
                                               Margin="0,2,0,0" />
                                </StackPanel>

                                <Border Grid.Column="2" Style="{StaticResource Pill}"
                                        VerticalAlignment="Center" Margin="8,0,10,0">
                                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource PillText}" />
                                </Border>

                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource RowAction}"
                                            Content="访问"
                                            Command="{Binding DataContext.Shell.OpenDeviceCommand,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                    <Button Style="{StaticResource RowAction}"
                                            Content="授权"
                                            Margin="4,0,0,0"
                                            Command="{Binding DataContext.Shell.GrantDeviceCommand,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                    <!-- 断开 / 连接：只断会话，不动配对与授权 -->
                                    <Button Style="{StaticResource RowAction}"
                                            Content="{Binding ConnectionActionText}"
                                            Margin="4,0,0,0"
                                            Command="{Binding DataContext.Shell.ToggleDeviceConnectionCommand,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                    <Button Style="{StaticResource RowAction}"
                                            Content="改名"
                                            Margin="4,0,0,0"
                                            Command="{Binding DataContext.Shell.RenameDeviceCommand,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding DeviceId}" />
                                    <Button Style="{StaticResource DangerRowAction}"
                                            Content="删除"
                                            Margin="4,0,0,0"
                                            Command="{Binding DataContext.Shell.DeleteDeviceCommand,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding DeviceId}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 断开/连接的结果：几秒后自动消失 -->
                <TextBlock Text="{Binding Shell.DeviceActionHint}"
                           TextWrapping="Wrap"
                           Margin="10,6,10,4">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Shell.HasDeviceActionHint}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- 空态：没有设备时直接给配对提示 -->
                <StackPanel Margin="10,14,10,10">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Shell.HasDevices}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="等待手机连接" Style="{StaticResource BodyText}" />
                    <TextBlock Text="手机上打开 WirelessCable，与电脑连同一 Wi-Fi 即可被发现。"
                               Style="{StaticResource MutedText}"
                               Margin="0,4,0,0" />
                </StackPanel>

                <Border Height="1" Background="{DynamicResource LineBrush}" Margin="10,2,10,6">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Shell.HasDevices}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>

                <!-- 二维码：扫码配对，不用手输地址 -->
                <StackPanel Orientation="Horizontal" Margin="4,2,4,4">
                    <Button Style="{StaticResource GhostButton}"
                            Content="添加手机（扫码）"
                            Command="{Binding Shell.ShowPairingQrCommand}" />
                    <TextBlock Text="{Binding Shell.QrStatusText}"
                               Style="{StaticResource MutedText}"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0" />
                </StackPanel>

                <Border Margin="10,4,10,10"
                        HorizontalAlignment="Left"
                        Background="White"
                        CornerRadius="8"
                        Padding="10"
                        BorderBrush="{DynamicResource LineBrush}"
                        BorderThickness="1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Shell.QrImage}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Image Source="{Binding Shell.QrImage}" Width="180" Height="180"
                           RenderOptions.BitmapScalingMode="NearestNeighbor" />
                </Border>

                <!-- 电脑热点：手机与电脑不在同一网络时，手机连它再扫码 -->
                <StackPanel Orientation="Horizontal" Margin="10,0,10,10">
                    <TextBlock Text="{Binding Shell.HotspotText}"
                               Style="{StaticResource MutedText}"
                               VerticalAlignment="Center" />
                    <Button Content="关闭热点"
                            Margin="10,0,0,0"
                            Command="{Binding Shell.StopHotspotCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Shell.IsHotspotActive}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 配对请求：新设备请求直接给允许/拒绝 -->
        <StackPanel Margin="0,20,0,0">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Shell.HasPairingRequests}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>

            <TextBlock Text="配对请求" Style="{StaticResource SectionTitle}" Margin="0,0,0,10" />

            <ItemsControl ItemsSource="{Binding Shell.PendingPairingRequests}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding DeviceName}" FontSize="15" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding PlatformText}"
                                                   Style="{StaticResource MutedText}"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>

                                    <Border Grid.Column="1" Style="{StaticResource Pill}">
                                        <TextBlock Text="{Binding StateText}" Style="{StaticResource PillText}" />
                                    </Border>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <TextBlock Text="{Binding Code}"
                                               FontSize="26"
                                               FontWeight="Bold"
                                               FontFamily="{StaticResource MonoFont}" />
                                    <TextBlock Text="{Binding ExpiresText}"
                                               Style="{StaticResource MutedText}"
                                               VerticalAlignment="Bottom"
                                               Margin="14,0,0,6" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Style="{StaticResource PrimaryButton}"
                                            Content="允许"
                                            Margin="0,0,8,0"
                                            Command="{Binding DataContext.Shell.ApprovePairingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding RequestId}" />
                                    <Button Style="{StaticResource GhostButton}"
                                            Content="拒绝"
                                            Command="{Binding DataContext.Shell.RejectPairingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding RequestId}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

    </StackPanel>
</UserControl>
