# 统一换行符，避免 Windows / macOS 协作时整文件 diff
* text=auto

# 脚本按各自平台的习惯
*.sh   text eol=lf
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# 二进制：不要尝试合并或转换
*.png  binary
*.jpg  binary
*.jpeg binary
*.ico  binary
*.webp binary
*.ttf  binary
*.otf  binary
*.woff binary
*.woff2 binary
*.zip  binary
*.apk  binary
*.exe  binary
*.jks  binary
*.pfx  binary
*.db   binary
